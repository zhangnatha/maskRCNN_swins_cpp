# Project specific
/build/
build/
3rdparty/

# Ignore contents of model and assets, but keep folders tracked via .gitkeep
model/*
!model/.gitkeep

assets/*
!assets/**/.gitkeep
!assets/fixed/
!assets/followed/
assets/fixed/*
!assets/fixed/.gitkeep
assets/followed/*
!assets/followed/.gitkeep

# Compiled Object & Library files
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exe

# CMake & build outputs
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary & debug files
*.tmp
*.log
*.bak
*.swp
.cache/
